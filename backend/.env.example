# Sales Copilot backend configuration.
# Copy this file to backend/.env and fill in GROQ_API_KEY. Every other value
# already has a working default, so you can leave the rest untouched.

# REQUIRED. The only key you actually need. Free, no card, get one at
# https://console.groq.com/keys and paste it here.
GROQ_API_KEY=

# Groq OpenAI compatible API root. Change only if Groq moves the endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Whisper model used to transcribe each closed utterance.
STT_MODEL=whisper-large-v3-turbo

# Chat model that writes the teleprompter line the rep reads aloud.
# NOTE: Groq retired llama-3.3-70b-versatile. Every chat model Groq serves now
# is a reasoning model, and the backend suppresses their chain of thought per
# family (see reasoning_params in app/services/groq_client.py). Measured on a
# free key, first token to the teleprompter:
#   qwen/qwen3.6-27b     ~190 ms   <- default, best output for reading aloud
#   openai/gpt-oss-120b  ~490 ms
#   openai/gpt-oss-20b   ~500 ms
#   groq/compound-mini  ~1030 ms
LLM_MODEL=qwen/qwen3.6-27b

# Jina Reader endpoint used to scrape the prospect website, keyless by default.
JINA_BASE_URL=https://r.jina.ai/

# Optional Jina key. Leave empty for the keyless tier, set it to raise the rate limit.
JINA_API_KEY=

# Comma separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How long an idle call session stays in memory, in seconds (6 hours).
SESSION_TTL_SECONDS=21600

# Maximum characters kept from the scraped prospect page.
MAX_SCRAPE_CHARS=12000

# Maximum characters kept from your pasted knowledge base.
MAX_KB_CHARS=24000

# How many recent transcript turns are sent to the model on every suggestion.
TRANSCRIPT_WINDOW_TURNS=14

# Hard token ceiling per suggestion. Keep it small, the rep reads this out loud.
LLM_MAX_TOKENS=160

# Sampling temperature. Lower is safer and more repeatable on a live call.
LLM_TEMPERATURE=0.4

# Silence needed to close an utterance, in milliseconds.
VAD_SILENCE_MS=620

# Utterances shorter than this are discarded as noise, in milliseconds.
VAD_MIN_SPEECH_MS=260

# Force close a never ending utterance after this long, in milliseconds.
VAD_MAX_UTTERANCE_MS=12000

# Audio kept from just before speech starts so word openings are not clipped.
VAD_PREROLL_MS=320

# Python log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
