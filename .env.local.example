# =============================================================================
#  SALES COPILOT, environment template
#  Copy the two blocks below into the two files listed, then fill in the key.
#  Total monthly cost of this stack: 0. Groq free tier + Jina Reader (keyless).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) backend/.env      (the ONLY file that holds a secret)
# -----------------------------------------------------------------------------

# REQUIRED. Free key, no card needed: https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Speech to text model. whisper-large-v3-turbo is ~2x faster and free tier
# friendly. Swap to whisper-large-v3 if you need the last bit of accuracy.
STT_MODEL=whisper-large-v3-turbo

# The copilot brain, swappable with any Groq chat model id.
# NOTE: Groq retired llama-3.3-70b-versatile. Every chat model Groq serves now
# is a reasoning model, and the backend suppresses their chain of thought per
# family (see reasoning_params in app/services/groq_client.py). Measured on a
# free key, first token to the teleprompter:
#   qwen/qwen3.6-27b     ~190 ms   <- default, best output for reading aloud
#   openai/gpt-oss-120b  ~490 ms
#   openai/gpt-oss-20b   ~500 ms
#   groq/compound-mini  ~1030 ms
LLM_MODEL=qwen/qwen3.6-27b

GROQ_BASE_URL=https://api.groq.com/openai/v1

# Jina AI Reader. Keyless works fine (20 req/min). A free key raises the limit
# to 200 req/min: https://jina.ai/reader
JINA_BASE_URL=https://r.jina.ai/
JINA_API_KEY=

# Where the Next.js app runs, for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Voice activity detection tuning. Raise VAD_SILENCE_MS if the copilot cuts the
# prospect off mid sentence, lower it if suggestions feel late.
VAD_SILENCE_MS=620
VAD_MIN_SPEECH_MS=260
VAD_MAX_UTTERANCE_MS=12000
VAD_PREROLL_MS=320

# Copilot output shaping
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.4
TRANSCRIPT_WINDOW_TURNS=14

# Context sizing
MAX_SCRAPE_CHARS=12000
MAX_KB_CHARS=24000
SESSION_TTL_SECONDS=21600

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 2) frontend/.env.local     (no secrets here, this reaches the browser)
# -----------------------------------------------------------------------------

# Server side only, used by the Next.js proxy route handlers
BACKEND_HTTP_URL=http://127.0.0.1:8000

# Public, the browser opens the WebSocket directly against this
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000
