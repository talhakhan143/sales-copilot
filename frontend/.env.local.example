# SalesCopilot frontend environment
# Copy this file to .env.local and restart "next dev" after any change,
# Next reads env files once at boot and inlines NEXT_PUBLIC_ values at build time.

# Where the Next.js route handlers (app/api/prepare-context, app/api/health)
# forward to. Server side only: no NEXT_PUBLIC_ prefix, so it never reaches the
# browser. Change it when FastAPI is not on this machine, for example
# http://backend:8000 inside Docker Compose, or a LAN IP.
BACKEND_HTTP_URL=http://127.0.0.1:8000

# Where the browser opens the teleprompter WebSocket. This one IS public, it is
# inlined into the client bundle, so keep it free of anything secret. A socket
# cannot be proxied through a route handler, so the browser dials FastAPI
# directly. Leave it unset to auto derive from window.location (same hostname,
# port 8000, wss when the page is https). Set it when the backend lives on a
# different host or port than the page, for example wss://api.example.com.
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000

# NOTE: GROQ_API_KEY does NOT belong in this file and does not belong anywhere in
# the frontend. It lives in backend/.env and is only ever read by the FastAPI
# process. Anything defined here can end up in the browser bundle, and a key in a
# browser bundle is a public key.
